# ---------------------------------------------------------------------------
# docker-mailserver v15 — Sychos Mail
# Dokumentation: https://docker-mailserver.github.io/docker-mailserver/latest/config/environment/
# Nur VAR=WERT, keine Anfuehrungszeichen, keine Variablen-Expansion.
# ---------------------------------------------------------------------------

# --- Identitaet ------------------------------------------------------------
OVERRIDE_HOSTNAME=mail.sychos.de
POSTMASTER_ADDRESS=postmaster@sychos.de
TZ=Europe/Berlin

# --- Konten / Quota --------------------------------------------------------
# Quota wird pro Postfach in dovecot-quotas.cf gesetzt (setup quota set ... 3G)
ENABLE_QUOTAS=1
# Max. Groesse einer einzelnen Nachricht (Bytes) = 50 MB
POSTFIX_MESSAGE_SIZE_LIMIT=52428800

# --- TLS -------------------------------------------------------------------
# Zertifikat liegt in ./tls (cert.pem + key.pem), per scripts/tls-selfsigned.sh
# erzeugt bzw. per scripts/letsencrypt.sh durch echtes Let's Encrypt ersetzt.
SSL_TYPE=manual
SSL_CERT_PATH=/etc/dms/tls/cert
SSL_KEY_PATH=/etc/dms/tls/key

# --- Spam / Viren ----------------------------------------------------------
ENABLE_RSPAMD=1
ENABLE_RSPAMD_REDIS=0
ENABLE_CLAMAV=1
CLAMAV_MESSAGE_SIZE_LIMIT=50M
SPAMASSASSIN_SPAM_TO_INBOX=1
MOVE_SPAM_TO_JUNK=1
ENABLE_FAIL2BAN=1
FAIL2BAN_BLOCKTYPE=drop

# --- Alte Filter-Implementierungen aus ------------------------------------
ENABLE_AMAVIS=0
ENABLE_OPENDKIM=0
ENABLE_OPENDMARC=0
ENABLE_POLICYD_SPF=0
ENABLE_POSTGREY=0
ENABLE_SPAMASSASSIN=0

# --- Komfort ---------------------------------------------------------------
ENABLE_SRS=1
ENABLE_MANAGESIEVE=1
ENABLE_UPDATE_CHECK=0
LOG_LEVEL=info

# --- Netwerk / Relay -------------------------------------------------------
# Niemandem blind vertrauen (kein Open Relay). Webmail authentifiziert sich.
PERMIT_DOCKER=none
DMS_TRUSTED_NETWORKS=none
POSTFIX_INET_PROTOCOLS=ipv4

# Wenn der eigene Anschluss keine Mail rausschicken darf (typisch bei
# Privatanschluessen: Port 25 gesperrt / keine PTR), alles ueber einen
# Smarthost leiten und hier eintragen:
#   DEFAULT_RELAY_HOST=[smtp.ionos.de]:587
#   RELAY_USER=...
#   RELAY_PASSWORD=...
DEFAULT_RELAY_HOST=
